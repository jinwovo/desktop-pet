<Window x:Class="DesktopPet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopPet.App"
        Title="DesktopPet 설정"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F9"
        FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE2E2E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="350"/></DataTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="언어" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="LanguageCombo" SelectedValuePath="Tag" SelectionChanged="Language_Changed">
                <ComboBoxItem Content="Windows 언어 사용" Tag="auto"/>
                <ComboBoxItem Content="한국어" Tag="ko"/>
                <ComboBoxItem Content="English" Tag="en"/>
                <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
            </ComboBox>
        </DockPanel>

        <!-- character -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="GalleryButton" Content="갤러리 · 검색" DockPanel.Dock="Right" Padding="9,4" Click="Gallery_Click"/>
                    <TextBlock Text="캐릭터" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left"
                            Width="144" Height="144"
                            Background="#FFF0F3F8"
                            CornerRadius="6"
                            Margin="0,0,12,0">
                        <Grid>
                            <Image x:Name="PreviousPreviewImage" Stretch="Uniform" Margin="4"
                                   IsHitTestVisible="False" Focusable="False" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <local:GroundedRigVisual x:Name="PreviewRig" Margin="4" Visibility="Collapsed" />
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <ComboBox x:Name="CharacterCombo"
                                  SelectionChanged="CharacterCombo_SelectionChanged" />
                        <TextBlock Text="동작 미리보기" FontSize="11" Foreground="#FF666666" Margin="0,10,0,4" />
                        <ComboBox x:Name="PreviewStateCombo" DisplayMemberPath="Label" SelectedValuePath="State"
                                  SelectionChanged="PreviewStateCombo_SelectionChanged" />
                        <TextBlock x:Name="CharacterHint"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#FF888888"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="AddCharacterButton" Content="캐릭터 추가" Padding="12,5" Click="AddCharacter_Click" />
                    <Button x:Name="AddArchiveButton" Content="ZIP 추가" Padding="12,5" Margin="8,0,0,0" Click="AddArchive_Click" />
                    <Button x:Name="FolderButton" Content="보관 폴더 열기" Padding="12,5" Margin="8,0,0,0" Click="FolderButton_Click" />
                </StackPanel>
                <TextBlock x:Name="CharacterImportStatusText" FontSize="11" Foreground="#FF777777" TextWrapping="Wrap"
                           Margin="0,6,0,0" Text="character.json이 있는 폴더나 캐릭터 ZIP을 추가하세요. 여러 캐릭터가 있으면 하나를 선택할 수 있어요." />
            </StackPanel>
        </Border>

        <!-- size / speed -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="크기와 속도" Style="{StaticResource SectionLabel}" />

                <DockPanel Margin="0,2,0,0">
                    <TextBlock Text="크기" Width="52" VerticalAlignment="Center" />
                    <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Width="48"
                               TextAlignment="Right" VerticalAlignment="Center" Foreground="#FF666666" />
                    <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.5"
                            TickFrequency="0.25" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Margin="4,0"
                            ValueChanged="ScaleSlider_ValueChanged" />
                </DockPanel>

                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="걷기 속도" Width="52" VerticalAlignment="Center" />
                    <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Width="48"
                               TextAlignment="Right" VerticalAlignment="Center" Foreground="#FF666666" />
                    <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="3.0"
                            TickFrequency="0.25" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Margin="4,0"
                            ValueChanged="SpeedSlider_ValueChanged" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="집중 타이머" Style="{StaticResource SectionLabel}" />
                <TextBlock x:Name="FocusStatusText" FontSize="17" FontWeight="SemiBold" Foreground="#314A3C" />
                <TextBlock Text="시간 변경은 다음 시작·다시 시작부터 적용해요. 다음 세션은 직접 시작해요."
                           Margin="0,5,0,10" FontSize="11" Foreground="#777777" TextWrapping="Wrap" />
                <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="집중(분)" VerticalAlignment="Center"/>
                    <TextBox x:Name="FocusMinutesBox" Width="42" Margin="6,0,12,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="휴식(분)" VerticalAlignment="Center"/>
                    <TextBox x:Name="BreakMinutesBox" Width="42" Margin="6,0,6,0" VerticalContentAlignment="Center"/>
                    <Button x:Name="FocusDurationApplyButton" Content="시간 적용" Padding="8,4" Click="FocusDurationApply_Click"/>
                </WrapPanel>
                <TextBlock x:Name="FocusDurationStatus" FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel>
                    <Button x:Name="FocusStartButton" Content="집중 시작" Padding="10,5" Click="FocusStart_Click" />
                    <Button x:Name="FocusPauseButton" Content="일시정지" Padding="10,5" Margin="6,0,0,0" Click="FocusPause_Click" />
                    <Button x:Name="FocusRestartButton" Content="다시 시작" Padding="10,5" Margin="6,0,0,0" Click="FocusRestart_Click" />
                    <Button x:Name="FocusStopButton" Content="종료" Padding="10,5" Margin="6,0,0,0" Click="FocusStop_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- behaviour toggles -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="모션과 화면 갱신" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="FrameRateCombo" SelectedValuePath="Tag" SelectionChanged="RenderOptions_Changed">
                    <ComboBoxItem Content="30 FPS · 절약" Tag="30"/>
                    <ComboBoxItem Content="60 FPS · 기본" Tag="60"/>
                    <ComboBoxItem Content="120 FPS · 고주사율" Tag="120"/>
                </ComboBox>
                <CheckBox x:Name="ReducedMotionCheck" Content="움직임 줄이기 · 점프·강한 알림·창 연출·페이드 끄기"
                          Checked="RenderOptions_Changed" Unchecked="RenderOptions_Changed"/>
                <TextBlock Text="걷기와 발의 접지는 유지합니다. FPS는 최대 갱신 빈도이며 실제 성능은 화면과 PC에 따라 달라요."
                           FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="동작" Style="{StaticResource SectionLabel}" />
                <CheckBox x:Name="VisibleCheck" Content="펫 보이기" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                <CheckBox x:Name="FullscreenCheck" Content="전체화면 앱을 사용할 때 잠시 숨기기" Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed" />
                <CheckBox x:Name="HopCheck" Content="창 사이를 뛰어다니기" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                <CheckBox x:Name="SleepCheck" Content="오래 방치하면 잠자기" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                <CheckBox x:Name="CalmCheck" Content="차분한 움직임" Checked="Comfort_Changed" Unchecked="Comfort_Changed" />
                <CheckBox x:Name="GentleCheck" Content="완료 말풍선을 잠시 후 닫기" Checked="Comfort_Changed" Unchecked="Comfort_Changed" />
                <CheckBox x:Name="QuietCheck" Content="방해 금지 · 말풍선 없이 보관" Checked="Comfort_Changed" Unchecked="Comfort_Changed" />
                <CheckBox x:Name="QuietHoursCheck" Content="매일 예약 방해 금지"/>
                <WrapPanel Margin="24,6,0,0">
                    <TextBox x:Name="QuietStartBox" Width="55" VerticalContentAlignment="Center"/>
                    <TextBlock Text=" ~ " VerticalAlignment="Center"/>
                    <TextBox x:Name="QuietEndBox" Width="55" VerticalContentAlignment="Center"/>
                    <Button x:Name="QuietHoursApplyButton" Content="예약 적용" Padding="8,4" Margin="8,0,0,0" Click="QuietHoursApply_Click"/>
                </WrapPanel>
                <TextBlock x:Name="QuietHoursStatus" FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="24,4,0,4"
                           Text="로컬 시간 HH:mm. 자정을 넘길 수 있고 같은 시간은 예약하지 않아요."/>
                <Button Content="테스트 알림" HorizontalAlignment="Left" Padding="10,5" Margin="0,5,0,6" Click="TestNotification_Click" />
                <CheckBox x:Name="WindowFallCheck" Content="창 닫을 때 떨어지는 연출" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                <TextBlock Text="창 연출을 끄면 다른 프로그램의 창을 주기적으로 캡처하지 않아 더 가볍습니다."
                           FontSize="11" Foreground="#FF888888" TextWrapping="Wrap" Margin="24,4,0,0" />
            </StackPanel>
        </Border>

        <!-- actions -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="설정 백업과 복원" Style="{StaticResource SectionLabel}"/>
                <WrapPanel>
                    <Button x:Name="BackupPreferencesButton" Content="설정 백업" Padding="10,5" Click="BackupPreferences_Click"/>
                    <Button x:Name="RestorePreferencesButton" Content="설정 복원" Padding="10,5" Margin="8,0,0,0" Click="RestorePreferences_Click"/>
                </WrapPanel>
                <TextBlock x:Name="PreferencesTransferStatus" Text="화면·동작·시간 설정만 옮깁니다. AI 연결·훅 허용·개인 경로는 포함하지 않아요."
                           FontSize="11" Foreground="#777777" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <DockPanel>
            <Button Content="움직임 시험" DockPanel.Dock="Left" Margin="8,0,0,0"
                    Padding="10,5" Click="MotionPreviewButton_Click" />
            <Button Content="AI 연결" DockPanel.Dock="Left" Margin="8,0,0,0"
                    Padding="10,5" Click="AssistantConnections_Click" />
            <Button x:Name="CloseButton" Content="닫기" DockPanel.Dock="Right"
                    Padding="18,5" Click="CloseButton_Click" IsDefault="True" />
            <TextBlock />
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
