<Window x:Class="DesktopPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopPet.App"
        mc:Ignorable="d"
        Title="DesktopPet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        Width="128" Height="128">
    <Grid x:Name="ActorVisualRoot" Background="Transparent"
          MouseLeftButtonDown="PetImage_MouseLeftButtonDown" MouseMove="PetImage_MouseMove"
          MouseLeftButtonUp="PetImage_MouseLeftButtonUp" LostMouseCapture="PetImage_LostMouseCapture">
        <Grid.RenderTransform><TranslateTransform x:Name="ResidualOffset" /></Grid.RenderTransform>
        <Image x:Name="PreviousPetImage" Stretch="Uniform" IsHitTestVisible="False" Focusable="False"
               Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
        <local:GroundedRigVisual x:Name="PetRig" Visibility="Collapsed" />
        <Image x:Name="PetImage"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="FlipTransform" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
