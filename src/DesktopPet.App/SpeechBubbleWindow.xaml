<Window x:Class="DesktopPet.App.SpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet.Bubble"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        Width="280">
    <Grid Margin="10,10,10,18">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.16" Color="#47594E" />
        </Grid.Effect>

        <!-- bubble body -->
        <Border Background="#FFFCFDFB"
                BorderBrush="#FFCCD7D0"
                BorderThickness="1.5"
                CornerRadius="14">
            <StackPanel Margin="14,11,14,12">
                <TextBlock x:Name="SourceText"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="#FF52695D"
                           Margin="0,0,0,2"
                           Visibility="Collapsed" />
                <TextBlock x:Name="TitleText"
                           Text="작업 완료"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#FF385546"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Text=""
                           FontSize="13"
                           Foreground="#FF222222"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           MaxHeight="120"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="AcknowledgementText" Text="클릭해서 확인"
                           FontSize="11"
                           Foreground="#FF8A8A8A"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- tail, pointing down at the pet -->
        <Path Fill="#FFFCFDFB"
              Stroke="#FFCCD7D0"
              StrokeThickness="1.5"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,-13"
              Data="M 0,0 L 16,0 L 8,14 Z" />
    </Grid>
</Window>
