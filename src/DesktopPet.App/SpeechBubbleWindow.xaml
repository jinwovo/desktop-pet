<Window x:Class="DesktopPet.App.SpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet.Bubble"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        Width="280">
    <Grid Margin="10,10,10,18">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#333" />
        </Grid.Effect>

        <!-- bubble body -->
        <Border Background="#FFFFFDF7"
                BorderBrush="#FF2E2E2E"
                BorderThickness="3"
                CornerRadius="14">
            <StackPanel Margin="14,11,14,12">
                <TextBlock x:Name="TitleText"
                           Text="작업 완료"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#FFD2254A"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Text=""
                           FontSize="13"
                           Foreground="#FF222222"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           MaxHeight="120"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="클릭해서 확인"
                           FontSize="11"
                           Foreground="#FF8A8A8A"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- tail, pointing down at the pet -->
        <Path Fill="#FFFFFDF7"
              Stroke="#FF2E2E2E"
              StrokeThickness="3"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,-13"
              Data="M 0,0 L 16,0 L 8,14 Z" />
    </Grid>
</Window>
